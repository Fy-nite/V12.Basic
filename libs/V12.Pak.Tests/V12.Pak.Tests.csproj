<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>V12.Pak.Tests</AssemblyName>
    <RootNamespace>V12.Pak.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(V12PakProject)" />
    <ProjectReference Include="TestGamePak\TestGamePak.csproj" />
    <!-- TestGamePak is a separate project; don't compile it (or its obj/) twice. -->
    <Compile Remove="TestGamePak/**" />
  </ItemGroup>

</Project>
